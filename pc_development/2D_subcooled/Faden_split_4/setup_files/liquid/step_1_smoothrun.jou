file set-batch-options n n n
file read-case-data "case_restart.cas.h5"

define boundary-conditions fluid , n n n n n , n , n y n
define dynamic-mesh zones delete boundary

define dynamic-mesh dynamic-mesh y n n n n
define dynamic-mesh controls smoothing y
define dynamic-mesh controls smoothing-parameters smoothing-method diffusion
define dynamic-mesh controls smoothing-parameters diffusion-coeff-function boundary-distance
define dynamic-mesh controls smoothing-parameters diffusion-coeff-parameter 1.0
define dynamic-mesh controls smoothing-parameters max-iter 50
define dynamic-mesh controls layering n
define dynamic-mesh controls remeshing n

; For diffusion-based smoothing
define dynamic-mesh zones create top deforming plane 0.0002 0.04 0 1 n y n y n y
define dynamic-mesh zones create bottom deforming plane 0.0002 0.04 0 1 n y n y n y
define dynamic-mesh zones create fluid deforming y n y

; For spring-based smoothing
; define dynamic-mesh zones create top deforming plane 0.0002 0.04 0 1 n y n n y n y
; define dynamic-mesh zones create bottom deforming plane 0.0002 0.04 0 1 n y n n y n y
; define dynamic-mesh zones create fluid deforming y global y y

define user-defined compiled-functions unload "udf_thermal"

file write-case-data "case_restart.cas.h5"
file cff-files? n
file write-case "remesh/case_restart.cas"
exit