/FLAT PLATE COMPONENT DOMAIN

/ --- Geometric parameters
$l = 0.01134
$h = 0.00081

$l_half = $l / 2
$h_half = $h / 2
$l_out_half = 3 * $l / 2
$h_out_half = $h / 2 + $l

/ --- Mesh size parameters
$nodes_long = 70
$nodes_short = 10
$radial_first = 0.00005
$nodes_radial = 80
$nodes_circum = 60

/CODE
save name "component.dbs"
solver select "FLUENT 5/6"

/ --- Create  vertices
vertex create "PlateTL" coordinates -$l_half $h_half 0
vertex create "PlateTR" coordinates $l_half $h_half 0
vertex create "PlateBL" coordinates -$l_half -$h_half 0
vertex create "PlateBR" coordinates $l_half -$h_half 0

vertex create "OuterArcTopL" coordinates -$l_half $h_out_half 0
vertex create "OuterArcTopR" coordinates $l_half $h_out_half 0
vertex create "OuterArcBottomL" coordinates -$l_half -$h_out_half 0
vertex create "OuterArcBottomR" coordinates $l_half -$h_out_half 0

vertex create "OuterArcTLeft" coordinates -$l_out_half $h_half 0
vertex create "OuterArcTRight" coordinates $l_out_half $h_half 0
vertex create "OuterArcBLeft" coordinates -$l_out_half -$h_half 0
vertex create "OuterArcBRight" coordinates $l_out_half -$h_half 0

/ --- Create 4 circular arcs in the corners
edge create "ArcTL" arc center2points "PlateTL" "OuterArcTopL" "OuterArcTLeft"
edge create "ArcBL" arc center2points "PlateBL" "OuterArcBLeft" "OuterArcBottomL"
edge create "ArcBR" arc center2points "PlateBR" "OuterArcBottomR" "OuterArcBRight"
edge create "ArcTR" arc center2points "PlateTR" "OuterArcTRight" "OuterArcTopR"

/ --- Create 4 straight sides of the plate
edge create "PlateTop" straight "PlateTL" "PlateTR"
edge create "PlateBottom" straight "PlateBR" "PlateBL"
edge create "PlateLeft" straight "PlateBL" "PlateTL"
edge create "PlateRight" straight "PlateTR" "PlateBR"

/ --- Create 4 straight sides of the overset boundary
edge create "OuterTop" straight "OuterArcTopL" "OuterArcTopR"
edge create "OuterBottom" straight "OuterArcBottomR" "OuterArcBottomL"
edge create "OuterLeft" straight "OuterArcBLeft" "OuterArcTLeft"
edge create "OuterRight" straight "OuterArcTRight" "OuterArcBRight"

/ --- Create inner edges between plate and overset boundary
edge create "InnerTopL" straight "OuterArcTopL" "PlateTL"
edge create "InnerTLeft" straight "OuterArcTLeft" "PlateTL"
edge create "InnerBLeft" straight "PlateBL" "OuterArcBLeft"
edge create "InnerBottomL" straight "PlateBL" "OuterArcBottomL"
edge create "InnerBottomR" straight "PlateBR" "OuterArcBottomR"
edge create "InnerBRight" straight "PlateBR" "OuterArcBRight"
edge create "InnerTRight" straight "OuterArcTRight" "PlateTR"
edge create "InnerTopR" straight "OuterArcTopR" "PlateTR"

/ --- Create 4 rectangular faces
face create "Left" wireframe "InnerTLeft" "OuterLeft" "InnerBLeft" "PlateLeft"
face create "Bottom" wireframe "InnerBottomL" "OuterBottom" "InnerBottomR" "PlateBottom"
face create "Top" wireframe "InnerTopL" "OuterTop" "InnerTopR" "PlateTop"
face create "Right" wireframe "InnerTRight" "OuterRight" "InnerBRight" "PlateRight"

/ --- Create 4 corner faces
face create "TopLeft" wireframe "ArcTL" "InnerTLeft" "InnerTopL"
face create "BottomLeft" wireframe "ArcBL" "InnerBottomL" "InnerBLeft"
face create "TopRight" wireframe "ArcTR" "InnerTopR" "InnerTRight"
face create "BottomRight" wireframe "ArcBR" "InnerBRight" "InnerBottomR"

/ --- Mesh circumferential edges
edge mesh "ArcTL" "ArcBL" "ArcBR" "ArcTR" intervals $nodes_circum
edge mesh "PlateTop" "PlateBottom" "OuterTop" "OuterBottom" intervals $nodes_long
edge mesh "PlateLeft" "PlateRight" "OuterLeft" "OuterRight" intervals $nodes_short

/ --- Mesh radial edges
edge mesh "InnerTopL" "InnerTLeft" "InnerTopR" "InnerTRight" intervals $nodes_radial firstlength ratio1 $radial_first reverse
edge mesh "InnerBottomL" "InnerBLeft" "InnerBottomR" "InnerBRight" intervals $nodes_radial firstlength ratio1 $radial_first

/ --- Mesh all fluid faces
face mesh "TopLeft" "BottomLeft" "TopRight" "BottomRight" triprimitive
face mesh "Left" "Bottom" "Right" "Top" submap

/ --- Apply boundary conditions
physics create "fluid.com" ctype "FLUID" face "Left" "Bottom" "Right" "Top" "TopLeft" "BottomLeft" "TopRight" "BottomRight"
physics create "outer" btype "WALL" edge "OuterLeft" "OuterBottom" "OuterRight" "OuterTop" "ArcTL" "ArcBL" "ArcBR" "ArcTR"
physics create "plate" btype "WALL" edge "PlateLeft" "PlateBottom" "PlateRight" "PlateTop"

/ --- Export mesh
export fluent5 "component.msh" nozval

save
end
